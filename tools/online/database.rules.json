{
 "rules": {
  ".read": false,
  ".write": false,
  "rooms": {
   ".read": false,
   "$code": {
    ".write": "auth != null && !newData.exists() && data.exists() && (data.child('meta/host').val() === auth.uid || data.child('meta/touched').val() < now - 1800000)",
    ".validate": "$code.matches(/^[BDFGHJKLMNRSTWXY]{5}$/)",
    "meta": {
     ".read": "auth != null && data.child('touched').val() > now - 1800000",
     ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.child('host').val() === auth.uid && data.child('touched').val() > now - 1800000))",
     ".validate": "newData.hasChildren(['host','track','laps','pace','state','run','touched'])",
     "host": {
      ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && newData.val() === auth.uid && (!root.child('rooms').child($code).child('players').child(data.val()).exists() || (root.child('rooms').child($code).child('players').child(data.val()).child('on').val() === false && root.child('rooms').child($code).child('players').child(data.val()).child('offAt').val() < now - 10000) || (root.child('rooms').child($code).child('meta/state').val() !== 'lobby' && root.child('rooms').child($code).child('meta/state').val() !== 'done' && root.child('rooms').child($code).child('meta/touched').val() < now - 120000))",
      ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,64}$/) && (newData.val() === auth.uid || root.child('rooms').child($code).child('players').child(newData.val()).exists())"
     },
     "locked": {
      ".validate": "newData.isBoolean()"
     },
     "look": {
      ".validate": "newData.isString() && newData.val().matches(/^(real|story)$/)"
     },
     "track": {
      ".validate": "newData.isString() && newData.val().matches(/^(kawaguchi|hakone|tokyo|city|accra|coast|desert|deep|inaka)$/)"
     },
     "laps": {
      ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
     },
     "pace": {
      ".validate": "newData.isString() && newData.val().matches(/^(gentle|normal)$/)"
     },
     "state": {
      ".validate": "newData.isString() && newData.val().matches(/^(lobby|load|count|race|done)$/)"
     },
     "run": {
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
     },
     "n": {
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
     },
     "scored": {
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
     },
     "goAt": {
      ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000"
     },
     "touched": {
      ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
      ".validate": "newData.val() === now || newData.val() === data.val()"
     },
     "$other": {
      ".validate": false
     }
    },
    "slots": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     "$n": {
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && ((!data.exists() && newData.val() === auth.uid && root.child('rooms').child($code).child('meta/state').val() === 'lobby' && root.child('rooms').child($code).child('meta/locked').val() !== true && !root.child('rooms').child($code).child('kick').child(auth.uid).exists() && root.child('rooms').child($code).child('slots/0').val() !== auth.uid && root.child('rooms').child($code).child('slots/1').val() !== auth.uid && root.child('rooms').child($code).child('slots/2').val() !== auth.uid && root.child('rooms').child($code).child('slots/3').val() !== auth.uid) || (data.val() === auth.uid && !newData.exists()) || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()))",
      ".validate": "$n.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 64"
     }
    },
    "players": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     "$uid": {
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && ((auth.uid === $uid && (!newData.exists() || (root.child('rooms').child($code).child('slots').child(newData.child('slot').val() + '').val() === auth.uid && !root.child('rooms').child($code).child('kick').child(auth.uid).exists()))) || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()))",
      ".validate": "newData.hasChildren(['car','paint','slot','on','ready','load'])",
      "car": {
       ".validate": "newData.isString() && newData.val().matches(/^(falcon|arrow|viper|formula|shogun|kente|kumasi|rally|retro|kei|ridge|razor|aurora|comet|breeze|monster|trophy|semi)$/)"
      },
      "paint": {
       ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
      },
      "name": {
       ".validate": "newData.isString() && newData.val().matches(/^[A-Z][a-z]{1,9}$/) && !newData.val().toLowerCase().matches(/^.*(f+u+c+k+|f+u+k+|s+h+i+t+|s+h+y+t+|b+i+t+c+h+|c+u+n+t+|n+i+g+g+|n+i+g+r+|f+a+g+g+|w+h+o+r+e+|s+l+u+t+|p+e+n+i+s+|v+a+g+i+n+a+|h+i+t+l+e+r+|p+o+r+n+|d+i+l+d+o+|b+a+s+t+a+r+d+|p+u+s+s+y+|w+a+n+k+|t+w+a+t+|d+i+c+k+h+e+a+d+|a+s+s+h+o+l+e+|b+o+l+l+o+c+k+|s+e+x+y+|s+t+u+p+i+d+|i+d+i+o+t+|r+e+t+a+r+d+|m+o+r+o+n+|k+k+k+|n+u+d+e+|n+a+k+e+d+|s+u+c+k+|n+i+p+p+l+e+|o+r+g+a+s+m+|e+r+o+t+i+c+|m+o+l+e+s+t+|p+a+e+d+o+|p+e+d+o+|t+e+r+r+o+r+|s+u+i+c+i+d+e+|k+i+l+l+e+r+).*$/) && !newData.val().toLowerCase().matches(/^(a+s+s+|a+r+s+e+|d+i+c+k+|c+o+c+k+|c+u+m+|s+e+x+|t+i+t+|t+i+t+s+|b+o+o+b+|b+o+o+b+s+|b+u+t+t+|b+u+m+|p+o+o+|p+o+o+p+|f+a+r+t+|p+i+s+s+|c+r+a+p+|d+a+m+n+|h+e+l+l+|a+n+u+s+|r+a+p+e+|n+a+z+i+|j+e+r+k+|d+u+m+b+|l+o+s+e+r+|u+g+l+y+|f+a+t+|h+a+t+e+|k+i+l+l+|d+i+e+|d+e+a+d+|d+r+u+n+k+|s+t+f+u+|w+t+f+|g+a+y+|f+a+g+|h+o+e+|h+o+|p+e+e+|w+e+e+)$/)"
      },
      "slot": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
      },
      "on": {
       ".validate": "newData.isBoolean()"
      },
      "ready": {
       ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9999"
      },
      "load": {
       ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9999"
      },
      "offAt": {
       ".validate": "newData.val() === now || newData.val() === data.val()"
      },
      "$other": {
       ".validate": false
      }
     }
    },
    "cars": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()",
     "$uid": {
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && ((auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()))",
      ".validate": "newData.hasChildren(['t','l','x','y','a','v','f','n'])",
      "t": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
      },
      "l": {
       ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9"
      },
      "x": {
       ".validate": "newData.isNumber() && newData.val() >= -99 && newData.val() <= 99"
      },
      "y": {
       ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 3000"
      },
      "a": {
       ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7"
      },
      "v": {
       ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 400"
      },
      "f": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1023"
      },
      "n": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000.0"
      },
      "$other": {
       ".validate": false
      }
     }
    },
    "bump": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()",
     "$uid": {
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && ((auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()))",
      ".validate": "newData.hasChildren(['to','s','i','n'])",
      "to": {
       ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,64}$/) && root.child('rooms').child($code).child('players').child(newData.val()).exists()"
      },
      "s": {
       ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)"
      },
      "i": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
      },
      "n": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90000000000000.0"
      },
      "$other": {
       ".validate": false
      }
     }
    },
    "finish": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()",
     "$uid": {
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && ((auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('rooms').child($code).child('meta/host').val() === auth.uid && !newData.exists()))",
      ".validate": "newData.hasChildren(['ms','run']) && newData.child('run').val() === root.child('rooms').child($code).child('meta/run').val() && (root.child('rooms').child($code).child('meta/state').val() === 'race' || root.child('rooms').child($code).child('meta/state').val() === 'count')",
      "ms": {
       ".validate": "newData.isNumber() && newData.val() >= 5000 && newData.val() <= 7200000"
      },
      "run": {
       ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
      },
      "$other": {
       ".validate": false
      }
     }
    },
    "order": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
     ".validate": "newData.hasChildren(['run','final'])",
     "run": {
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
     },
     "final": {
      ".validate": "newData.isBoolean()"
     },
     "list": {
      ".validate": "newData.hasChildren()",
      "$i": {
       ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,64}$/)"
      }
     },
     "$other": {
      ".validate": false
     }
    },
    "series": {
     ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000",
     ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
     "$uid": {
      ".validate": "$uid.matches(/^[A-Za-z0-9]{1,64}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 40",
      "$other": {
       ".validate": false
      }
     }
    },
    "kick": {
     "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && root.child('rooms').child($code).child('meta/touched').val() > now - 1800000 && root.child('rooms').child($code).child('meta/host').val() === auth.uid && $uid !== auth.uid",
      ".validate": "newData.isBoolean()"
     }
    },
    "$other": {
     ".validate": false
    }
   }
  }
 }
}
